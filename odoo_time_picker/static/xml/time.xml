<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="OdooTimePicker.Template">
        <div class="o_field_widget o_field_time_picker" t-on-click="onIconClick">
            <input type="time"
                   class="o_data_cell cursor-pointer o_field_cell o_list_char o_time_input"
                   step="1"
                   t-att-value="props.record.data[props.name] || ''"
                   t-on-change="(ev) => props.record.update({[props.name]: ev.target.value})"
                   style="width: 100%; cursor: pointer;"
                   t-att-readonly="props.readonly"
                   t-ref="timeInput"
            />
        </div>
    </t>

</templates>